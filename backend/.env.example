# Environment variables for local development
# Copy this to .env and fill in your values. Never commit .env to git.

# Database — use SQLite for local dev, change to postgres URL for production
SQLALCHEMY_DATABASE_URL=sqlite:///./app.db
# SQLALCHEMY_DATABASE_URL=postgresql://qrs_user:qrs_password@db:5432/qrs_db

# JWT — change this in production!
JWT_SECRET_KEY=dev-secret-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ChromaDB — "local" uses embedded on-disk, "http" uses the docker container
CHROMA_MODE=local
CHROMA_PERSIST_DIR=./chroma_data
# CHROMA_MODE=http
# CHROMA_HOST=chromadb
# CHROMA_PORT=8001

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.1

# RAG tuning
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.5

# Upload limits
MAX_UPLOAD_SIZE_MB=50

# CORS — Vite default port
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
